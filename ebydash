        def __init__(self, file_data: dict | None) -> None:
            super().__init__()
            self.file_data = file_data

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self._items: list[tuple[str, Any]] = []
        self._cursor: int = 0

    def compose(self) -> ComposeResult:
        yield self.title_bar()
        with PaneScroll():
            yield Static("loading…", id="files-body")

    def _redraw(self) -> None:
        lines = [
            f"[reverse]{d}[/reverse]" if i == self._cursor else d
            for i, (d, _) in enumerate(self._items)
        ]
        self.query_one("#files-body", Static).update(
            "\n".join(lines) if lines else "[dim]no files[/dim]"
        )

    def _update_diff(self) -> None:
        self.post_message(self.FileSelected(self._selected))

    def refresh_content(self, files: list[dict]) -> None:
        if not files:
            self._items = [("[bold green]✓ working tree clean[/bold green]", None)]
        else:
            items = []
            for f in files:
                x, y, path = f["x"], f["y"], f["path"]
                if x not in (" ", "?"):
                    disp = f"[green]{x}{y}[/green] {path}"
                elif y not in (" ", "?"):
                    disp = f"[red] {y}[/red] {path}"
                else:
                    disp = f"[dim]??[/dim] {path}"
                items.append((disp, f))
            self._items = items
        self._cursor = min(self._cursor, max(0, len(self._items) - 1))
        self._redraw()
        self._update_diff()

    def action_cursor_up(self) -> None:
        if self._cursor > 0:
            self._cursor -= 1
            self._redraw()
            self._update_diff()
            self._scroll_to_cursor()

    def action_cursor_down(self) -> None:
        if self._cursor < len(self._items) - 1:
            self._cursor += 1
            self._redraw()
            self._update_diff()
            self._scroll_to_cursor()

    def _scroll_to_cursor(self) -> None:
        try:
            scroll = self.query_one("PaneScroll", PaneScroll)
            target_y = self._cursor
            scroll.scroll_to(y=target_y, animate=False)
        except Exception:
            pass

    @property
    def _selected(self) -> Any:
        if self._items and 0 <= self._cursor < len(self._items):
            return self._items[self._cursor][1]
        return None

    def _msg(self, text: str, severity: str = "information") -> None:
        self.app.call_from_thread(
            lambda t=text, s=severity: self.app.notify(t, severity=s)
        )

    def _reload(self) -> None:
        self.app.call_from_thread(self.app.action_refresh)

    def action_toggle_stage(self) -> None:
        f = self._selected
        if not f:
            return
        path, staged = f["path"], f["staged"]
        def do():
            if staged:
                out, rc = shell_out(f"git restore --staged -- {shlex.quote(path)}")
            else:
                out, rc = shell_out(f"git add -- {shlex.quote(path)}")
            if rc != 0:
                self._msg(f"Error: {out[:80]}", "error")
            self._reload()
        run_bg(do)

    def action_stage_all(self) -> None:
        def do():
            out, rc = shell_out("git add -A")
            if rc == 0:
                self._msg("All files staged")
            else:
                self._msg(f"Error: {out[:80]}", "error")
            self._reload()
        run_bg(do)

    def action_commit(self) -> None:
        staged, _ = shell("git diff --cached --name-only 2>/dev/null")
        if not staged.strip():
            self.app.notify("Nothing staged to commit", severity="warning")
            return
        def on_msg(msg: str | None) -> None:
            if not msg:
                return
            def do():
                out, rc = shell_out(f"git commit -m {shlex.quote(msg)}")
                if rc == 0:
                    self._msg(out.split("\n")[0][:100] or "Committed")
                    self._reload()
                else:
                    self._msg(f"Commit failed: {out[:80]}", "error")
            run_bg(do)
        self.app.push_screen(InputModal("Commit message:", "feat: "), on_msg)


