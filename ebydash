# ── shell helpers ─────────────────────────────────────────────────────────────

def shell(cmd: str, timeout: int = 10) -> tuple[str, int]:
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        return r.stdout, r.returncode
    except Exception:
        return "", 1


def shell_out(cmd: str, timeout: int = 60) -> tuple[str, int]:
    """Run command; return combined stdout+stderr and returncode."""
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        return (r.stdout + r.stderr).strip(), r.returncode
    except subprocess.TimeoutExpired:
        return "timeout", 124
    except Exception as e:
        return str(e), 1


def run_bg(fn: Any) -> None:
    threading.Thread(target=fn, daemon=True).start()


# ── age helper ────────────────────────────────────────────────────────────────

def compact_age(rel: str) -> str:
    m = re.match(r"(\d+)\s+(\w+)", rel.strip().lower())
    if not m:
        return "?"
    n, u = int(m.group(1)), m.group(2)
    for prefix, suffix in (
        ("second", "s"), ("minute", "m"), ("hour", "h"),
        ("day", "d"), ("week", "w"), ("month", "M"), ("year", "y"),
    ):
        if u.startswith(prefix):
            return f"{n}{suffix}"
    return "?"


# ── data fetchers ─────────────────────────────────────────────────────────────

def fetch_status() -> str:
    root, rc = shell("git rev-parse --show-toplevel 2>/dev/null")
    if rc != 0:
        return "[bold red]✗ not a git repo[/bold red]"
    repo = Path(root.strip()).name
    branch, _ = shell("git branch --show-current 2>/dev/null")
    branch = branch.strip() or "HEAD (detached)"
    upstream, rc2 = shell(
        "git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null"
    )
    upstream = upstream.strip()
    ahead, _ = shell("git rev-list '@{u}..HEAD' --count 2>/dev/null")
    behind, _ = shell("git rev-list 'HEAD..@{u}' --count 2>/dev/null")
    ahead, behind = (ahead.strip() or "0"), (behind.strip() or "0")
    line1 = (
        f"[bold cyan]{repo}[/bold cyan] [dim]→[/dim] [bold yellow]{branch}[/bold yellow]"
    )
    if rc2 == 0 and upstream:
        badges = ""
        if ahead  != "0": badges += f" [bold green]↑{ahead}[/bold green]"
        if behind != "0": badges += f" [bold red]↓{behind}[/bold red]"
        line2 = f"[dim]{upstream}[/dim]{badges}"
    else:
        line2 = "[dim]no upstream[/dim]"
    return f"{line1}\n{line2}"


def fetch_branches_data() -> list[dict]:
    # Use | as separator — \t becomes literal tab in the shell and IFS splits on it
    out, rc = shell(
        "git for-each-ref --sort=-committerdate "
        "--format='%(refname:short)|%(committerdate:relative)|%(HEAD)|%(upstream:track)' "
        "refs/heads/ 2>/dev/null"
    )
    if rc != 0:
        return []
    branches = []
    for line in out.strip().splitlines():
        parts = line.split("|", 3)
        if len(parts) < 3:
            continue
        name       = parts[0].strip()
        age_raw    = parts[1].strip()
        is_current = parts[2].strip() == "*"
        track      = parts[3].strip() if len(parts) > 3 else ""
        age        = compact_age(age_raw) if not is_current else ""
        if not track:                                 sync = "✓"
        elif "gone" in track:                         sync = "✗"
        elif "ahead" in track and "behind" in track:  sync = "↕"
        elif "ahead" in track:                        sync = "↑"
        elif "behind" in track:                       sync = "↓"
        else:                                         sync = ""
        branches.append(
            {"name": name, "age": age, "is_current": is_current, "sync": sync}
        )
    return branches


def fetch_files_data() -> list[dict]:
    out, rc = shell("git status --porcelain 2>/dev/null")
    if rc != 0:
        return []
    files = []
    for line in out.splitlines():
        if len(line) < 3:
            continue
        x, y, path = line[0], line[1], line[3:]
        files.append({"x": x, "y": y, "path": path, "staged": x not in (" ", "?")})
    return files


def fetch_vpn_sessions() -> list[dict]:
    out, rc = shell("openvpn3 sessions-list 2>/dev/null", timeout=5)
    if rc != 0:
        return []
    text = out.strip()
    if not text or "No sessions" in text:
        return []
    sessions: list[dict] = []
    cur: dict = {}
    for line in text.splitlines():
        line = line.strip()
        if not line:
            if cur:
                sessions.append(cur)
            cur = {}
            continue
        if ":" in line:
            k, _, v = line.partition(":")
            k, v = k.strip().lower(), v.strip()
            if   "session path" in k: cur["path"]   = v
            elif "status"       in k: cur["status"] = v
            elif "config name"  in k: cur["config"] = v
            elif "device"       in k: cur["device"] = v
    if cur:
        sessions.append(cur)
    return sessions


def fetch_vpn_configs() -> list[str]:
    out, rc = shell("openvpn3 configs-list 2>/dev/null", timeout=5)
    if rc != 0:
        return []
    configs: list[str] = []
    for line in out.splitlines():
        line = line.strip()
        if not line or line.startswith("Config") or set(line) <= set("-= "):
            continue
        parts = line.split()
        if parts:
            c = parts[-1]
            if not c.startswith("/") and c not in ("path", "name", "alias"):
                configs.append(c)
    return list(dict.fromkeys(configs))


def fetch_system() -> str:
    try:
        import psutil
    except ImportError:
        return "[red]psutil not installed[/red]\n  pip install psutil"
    try:
        BAR = 18
        def bar(pct: float, color: str) -> str:
            filled = round(pct / 100 * BAR)
            return f"[{color}]{'█' * filled}{'░' * (BAR - filled)}[/{color}]"
        def pad_markup(text: str, width: int) -> str:
            # Keep Rich markup untouched while padding based on visible width.
            plain = re.sub(r"\[[^\]]+\]", "", text)
            return text + " " * max(0, width - len(plain))

        def join_cols(left: list[str], right: list[str], lw: int = 40) -> str:
            h = max(len(left), len(right))
            left = left + [""] * (h - len(left))
            right = right + [""] * (h - len(right))
            return "\n".join(f"{pad_markup(l, lw)}  {r}" for l, r in zip(left, right))

        # ── CPU (compact summary) ────────────────────────────────────────────
        cores = psutil.cpu_percent(interval=0.2, percpu=True)
        cpu_pct = (sum(cores) / len(cores)) if cores else psutil.cpu_percent(interval=0.2)
        c_cpu = "green" if cpu_pct < 60 else ("yellow" if cpu_pct < 85 else "red")
        load = psutil.getloadavg()

        # Show hottest cores only (top 3) to avoid long scrolling blocks.
        hot = sorted(enumerate(cores), key=lambda kv: kv[1], reverse=True)[:3]
        hot_line = "  ".join(
            f"[dim]c{i}[/dim]:[{('green' if p < 60 else 'yellow' if p < 85 else 'red')}]{p:4.0f}%[/{('green' if p < 60 else 'yellow' if p < 85 else 'red')}]"
            for i, p in hot
        ) if hot else "[dim]n/a[/dim]"

        left = [
            "[bold dim]CPU[/bold dim]",
            f"  {bar(cpu_pct, c_cpu)} [{c_cpu}]{cpu_pct:5.1f}%[/{c_cpu}]",
            f"  [dim]load[/dim] [bold]{load[0]:.2f} {load[1]:.2f} {load[2]:.2f}[/bold]",
            f"  {hot_line}",
        ]

        # ── Memory (compact summary) ─────────────────────────────────────────
        m = psutil.virtual_memory()
        ug = m.used / 1024**3
        tg = m.total / 1024**3
        c_mem = "green" if m.percent < 70 else ("yellow" if m.percent < 85 else "red")
        right = [
            "[bold dim]Memory[/bold dim]",
            f"  {bar(m.percent, c_mem)} [{c_mem}]{m.percent:5.1f}%[/{c_mem}]",
            f"  [dim]RAM[/dim] {ug:.1f}/{tg:.1f} GB",
        ]

        sw = psutil.swap_memory()
        if sw.total:
            sg = sw.used / 1024**3
            stg = sw.total / 1024**3
            c_sw = "green" if sw.percent < 50 else ("yellow" if sw.percent < 80 else "red")
            right.append(f"  [dim]Swap[/dim] [{c_sw}]{sw.percent:4.0f}%[/{c_sw}] [dim]{sg:.1f}/{stg:.1f} GB[/dim]")
        else:
            right.append("  [dim]Swap[/dim] n/a")

        return join_cols(left, right)
    except Exception as e:
        return f"[red]Error: {e}[/red]"


_claude_cache: dict = {"mtime_key": None, "result": ""}


def fetch_claude_stats() -> str:
    """Parse JSONL session files to produce a /usage-style token+cost summary."""
    projects_dir = Path.home() / ".claude" / "projects"
    if not projects_dir.exists():
        return "[dim]~/.claude/projects not found[/dim]"
    try:
        today_str = date.today().isoformat()

        # Only re-parse if any JSONL file has changed since last run
        mtime_key = (today_str, max(
            (f.stat().st_mtime for f in projects_dir.glob("**/*.jsonl")),
            default=0,
        ))
        if mtime_key == _claude_cache["mtime_key"] and _claude_cache["result"]:
            return _claude_cache["result"]

        # Aggregate per-project for today
        by_project: dict[str, dict] = {}

        for jsonl_file in projects_dir.glob("**/*.jsonl"):
            proj_raw = jsonl_file.parent.name
            # Derive a short readable project name
            proj = (
                proj_raw
                .replace("-home-eby-Projects-", "")
                .replace("-home-eby-Projects", "~")
                .replace("-home-eby-", "~/")
                .replace("-", "/", 1) if proj_raw.startswith("-home-eby-Projects-") else
                proj_raw.replace("-home-eby-Projects", "Projects")
                        .replace("-home-eby-", "~/")
            )
            if proj not in by_project:
                by_project[proj] = {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0}
            t = by_project[proj]
            for line in jsonl_file.read_text(errors="replace").splitlines():
                try:
                    obj = json.loads(line)
                    if not obj.get("timestamp", "").startswith(today_str):
                        continue
                    msg = obj.get("message", {})
                    if msg.get("role") != "assistant":
                        continue
                    usage = msg.get("usage", {})
                    if not usage:
                        continue
                    t["input"]       += usage.get("input_tokens", 0)
                    t["output"]      += usage.get("output_tokens", 0)
                    t["cache_write"] += usage.get("cache_creation_input_tokens", 0)
                    t["cache_read"]  += usage.get("cache_read_input_tokens", 0)
                except Exception:
                    pass

        # Drop projects with zero activity
        by_project = {k: v for k, v in by_project.items()
                      if any(v[f] for f in ("input", "output", "cache_write", "cache_read"))}

        if not by_project:
            return "[dim]No Claude usage today[/dim]"

        def total_tokens(t: dict) -> int:
            return t["input"] + t["output"] + t["cache_write"] + t["cache_read"]

        def fmt_k(n: int) -> str:
            return f"{n/1000:.1f}k" if n >= 1000 else str(n)

        lines = ["[bold]Claude Usage — Today[/bold]", ""]

        grand: dict = {"input": 0, "output": 0, "cache_write": 0, "cache_read": 0}

        for proj, t in sorted(by_project.items(), key=lambda kv: total_tokens(kv[1]), reverse=True):
            grand["input"]       += t["input"]
            grand["output"]      += t["output"]
            grand["cache_write"] += t["cache_write"]
            grand["cache_read"]  += t["cache_read"]
            lines.append(f"  [cyan]{proj[:28]:<28}[/cyan]  [dim]{fmt_k(total_tokens(t))} tok[/dim]")
            lines.append(
                f"    [dim]in[/dim] {fmt_k(t['input']):<6} "
                f"[dim]out[/dim] {fmt_k(t['output']):<6} "
                f"[dim]cache↑[/dim] {fmt_k(t['cache_write']):<6} "
                f"[dim]cache↓[/dim] {fmt_k(t['cache_read'])}"
            )

        lines += [
            "",
            "[bold dim]" + "─" * 44 + "[/bold dim]",
            f"  [bold]Total[/bold]  [bold green]{fmt_k(total_tokens(grand))} tokens[/bold green]",
            f"    [dim]in[/dim] {fmt_k(grand['input']):<6} "
            f"[dim]out[/dim] {fmt_k(grand['output']):<6} "
            f"[dim]cache↑[/dim] {fmt_k(grand['cache_write']):<6} "
            f"[dim]cache↓[/dim] {fmt_k(grand['cache_read'])}",
        ]
        result = "\n".join(lines)
        _claude_cache["mtime_key"] = mtime_key
        _claude_cache["result"]    = result
        return result
    except Exception as e:
        return f"[red]Error: {e}[/red]"


def fetch_spotify() -> dict:
    """Return Spotify playback state — 2 subprocess calls total."""
    # Single call: status + all metadata fields at once
    meta_out, rc = shell(
        "playerctl metadata --format "
        "'{{status}}|||{{title}}|||{{artist}}|||{{album}}|||{{mpris:length}}'"
        " 2>/dev/null",
        timeout=4,
    )
    if rc != 0 or not meta_out.strip() or "No players" in meta_out:
        return {"ok": False, "msg": "[dim]Spotify not running[/dim]"}

    parts  = meta_out.strip().split("|||", 4)
    status = parts[0].strip().lower() if parts else ""
    title  = parts[1].strip()[:50]   if len(parts) > 1 else ""
    artist = parts[2].strip()[:40]   if len(parts) > 2 else ""
    album  = parts[3].strip()[:40]   if len(parts) > 3 else ""
    raw_len = parts[4].strip()       if len(parts) > 4 else ""

    # Second call: position (not available as metadata field)
    pos_out, _ = shell("playerctl position 2>/dev/null", timeout=2)

    def fmt(secs: float) -> str:
        s = int(secs)
        return f"{s // 60}:{s % 60:02d}"

    try:
        pos_str = fmt(float(pos_out.strip()))
    except Exception:
        pos_str = ""
    try:
        len_str = fmt(int(raw_len) / 1_000_000)
    except Exception:
        len_str = ""

    return {
        "ok":      True,
        "playing": status == "playing",
        "status":  status,
        "title":   title,
        "artist":  artist,
        "album":   album,
        "pos":     pos_str,
        "length":  len_str,
    }


def fetch_diff(file_data: dict | None) -> str:
    if not file_data:
        return "[dim]  Select a file to preview diff[/dim]"
    path   = file_data.get("path", "")
    staged = file_data.get("staged", False)
    x      = file_data.get("x", " ")
    y      = file_data.get("y", " ")

    if not path:
        return "[dim]  No file selected[/dim]"

    # Untracked file — show full content as additions
    if x == "?" and y == "?":
        out, rc = shell(f"cat -- {shlex.quote(path)} 2>/dev/null")
        if rc != 0 or not out.strip():
            return f"[dim]  {path} (untracked, unreadable)[/dim]"
        lines = [f"[dim]  (untracked) {path}[/dim]", ""]
        for line in out.splitlines()[:200]:
            lines.append(f"[green]+  {rich_escape(line)}[/green]")
        return "\n".join(lines)

    # Staged diff
    if staged:
        out, rc = shell(f"git diff --cached -- {shlex.quote(path)} 2>/dev/null")
    else:
        out, rc = shell(f"git diff -- {shlex.quote(path)} 2>/dev/null")

    if not out.strip():
        # Could be a new staged file with no unstaged changes
        out, rc = shell(f"git diff --cached -- {shlex.quote(path)} 2>/dev/null")

    if not out.strip():
        return f"[dim]  No diff available for {path}[/dim]"

    lines = []
    for line in out.splitlines():
        if line.startswith("+++") or line.startswith("---"):
            lines.append(f"[bold dim]{rich_escape(line)}[/bold dim]")
        elif line.startswith("+"):
            lines.append(f"[green]{rich_escape(line)}[/green]")
        elif line.startswith("-"):
            lines.append(f"[red]{rich_escape(line)}[/red]")
        elif line.startswith("@@"):
            lines.append(f"[cyan]{rich_escape(line)}[/cyan]")
        elif line.startswith("diff ") or line.startswith("index "):
            lines.append(f"[dim]{rich_escape(line)}[/dim]")
        else:
            lines.append(rich_escape(line))
    return "\n".join(lines)


