class FilesPane(Pane):
    """Focusable pane — cursor state lives here, display is a plain Static."""

    _title = "[#7aa2f7][2][/#7aa2f7] FILES"
    can_focus = True

    BINDINGS = [
        Binding("up",    "cursor_up",    "Up",          show=False),
        Binding("down",  "cursor_down",  "Down",        show=False),
        Binding("space", "toggle_stage", "Stage/Unstage"),
