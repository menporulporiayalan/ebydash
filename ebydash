    #right  {
        width: 1fr;
        layout: vertical;
        padding: 0 1 1 0;
    }
    #status-pane   { height: 5;   }
    #files-pane    { height: 2fr; }
    #branches-pane { height: 2fr; }
    #vpn-pane      { height: 7;   }
    #diff-pane     { height: 3fr; }
    #system-pane   { height: 2fr; }
    #spotify-pane  { height: 2fr; }
    #claude-pane   { height: 2fr; }
    """

    BINDINGS = [
        Binding("q", "quit",    "Quit"),
        Binding("r", "refresh", "Refresh"),
        Binding("0", "focus_pane('diff-pane')",     show=False),
        Binding("1", "focus_pane('status-pane')",   show=False),
        Binding("2", "focus_pane('files-pane')",    show=False),
        Binding("3", "focus_pane('branches-pane')", show=False),
        Binding("4", "focus_pane('vpn-pane')",      show=False),
        Binding("5", "focus_pane('system-pane')",   show=False),
        Binding("6", "focus_pane('spotify-pane')",  show=False),
        Binding("7", "focus_pane('claude-pane')",   show=False),
    ]

    def compose(self) -> ComposeResult:
        with Container(id="left"):
            yield StatusPane(id="status-pane")
            yield FilesPane(id="files-pane")
            yield BranchPane(id="branches-pane")
            yield VPNPane(id="vpn-pane")
        with Container(id="right"):
            yield DiffPane(id="diff-pane")
            yield SystemPane(id="system-pane")
            yield SpotifyPane(id="spotify-pane")
            yield ClaudePane(id="claude-pane")
        yield Footer()

    # ── Fetcher registry ───────────────────────────────────────────────────────
    _FETCHERS: dict = {
        "status":   fetch_status,
        "files":    fetch_files_data,
        "branches": fetch_branches_data,
        "system":   fetch_system,
        "vpn":      fetch_vpn_sessions,
        "spotify":  fetch_spotify,
        "claude":   fetch_claude_stats,
    }

    def __init__(self):
        super().__init__()
        self._pool        = ThreadPoolExecutor(max_workers=6)
        self._cache: dict = {}          # last known values
        self._last:  dict[str, float] = {}   # last fetch timestamps
        self._diff_timer: threading.Timer | None = None

    def on_mount(self) -> None:
        self._do_refresh(force=True)
        self.set_interval(REFRESH_INTERVAL, self._do_refresh)

    @work(thread=True)
    def _do_refresh(self, force: bool = False) -> None:
        now = time.monotonic()

        # Submit only fetchers that are due
        futures = {
            key: self._pool.submit(fn)
            for key, fn in self._FETCHERS.items()
            if force or now - self._last.get(key, 0) >= _INTERVALS.get(key, 5)
        }

        for key, fut in futures.items():
            try:
                self._cache[key] = fut.result()
                self._last[key]  = now
            except Exception:
                pass  # keep stale cache value on error

        data = self._cache

        def apply() -> None:
            if "status"   in futures: self.query_one("#status-pane",   StatusPane).refresh_content(data["status"])
            if "files"    in futures: self.query_one("#files-pane",    FilesPane).refresh_content(data["files"])
            if "branches" in futures: self.query_one("#branches-pane", BranchPane).refresh_content(data["branches"])
            if "system"   in futures: self.query_one("#system-pane",   SystemPane).refresh_content(data["system"])
            if "spotify"  in futures: self.query_one("#spotify-pane",  SpotifyPane).refresh_content(data["spotify"])
            if "claude"   in futures: self.query_one("#claude-pane",   ClaudePane).refresh_content(data["claude"])
            if "vpn"      in futures: self.query_one("#vpn-pane",      VPNPane).refresh_content(data["vpn"])

        self.call_from_thread(apply)

    def on_files_pane_file_selected(self, event: FilesPane.FileSelected) -> None:
        """Debounced diff update — waits 150 ms after last cursor move."""
        if self._diff_timer:
            self._diff_timer.cancel()
        file_data = event.file_data
        def do():
            markup = fetch_diff(file_data)
            self.call_from_thread(
                lambda m=markup: self.query_one("#diff-pane", DiffPane).refresh_content(m)
            )
        self._diff_timer = threading.Timer(0.15, do)
        self._diff_timer.daemon = True
        self._diff_timer.start()

    def action_refresh(self) -> None:
        self._do_refresh(force=True)   # force=True bypasses interval cache

    def action_focus_pane(self, pane_id: str) -> None:
        try:
            pane = self.query_one(f"#{pane_id}")
            # BranchPane/FilesPane are directly focusable; others focus VerticalScroll
            if pane.can_focus:
                pane.focus()
            else:
                pane.query_one(VerticalScroll).focus()
        except Exception:
            pass


if __name__ == "__main__":
    PanelApp().run()
