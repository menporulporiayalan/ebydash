class VPNPane(Pane):
    _title = "[#7aa2f7][4][/#7aa2f7] VPN"

    BINDINGS = [
        Binding("c", "vpn_connect",    "Connect"),
        Binding("d", "vpn_disconnect", "Disconnect"),
    ]

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        # Store only plain data, never widget instances
        self._sessions: list[dict] = []

    def compose(self) -> ComposeResult:
        yield self.title_bar()
        with PaneScroll():
            yield Static("loading…", classes="vpn-body")

    def _body(self) -> Static | None:
        try:
            return self.query_one(".vpn-body", Static)
        except Exception:
            return None

    def refresh_content(self, sessions: list[dict]) -> None:
        self._sessions = sessions
        body = self._body()
        if body is None:
            return
        if not sessions:
            body.update(
                "[bold red]● Disconnected[/bold red]\n[dim]  c=connect[/dim]"
            )
            return
        rows: list[str] = []
        for s in sessions:
            status = s.get("status", "unknown")
            config = s.get("config", "?")
            device = s.get("device", "")
            if "connected" in status.lower():
                rows.append("[bold green]● Connected[/bold green]")
                rows.append(f"  Config: [cyan]{config}[/cyan]")
                if device:
                    rows.append(f"  Device: [dim]{device}[/dim]")
                rows.append("[dim]  d=disconnect[/dim]")
            elif "connecting" in status.lower():
                rows.append("[bold yellow]● Connecting…[/bold yellow]")
                rows.append(f"  [dim]{config}[/dim]")
            else:
                rows.append(f"[yellow]● {status}[/yellow]")
                rows.append(f"  [dim]{config}[/dim]")
        body.update("\n".join(rows))

    def _msg(self, text: str, severity: str = "information") -> None:
        self.app.call_from_thread(
            lambda t=text, s=severity: self.app.notify(t, severity=s)
        )

    def _reload(self) -> None:
        self.app.call_from_thread(self.app.action_refresh)

    def action_vpn_connect(self) -> None:
        self.app.notify("Connecting VPN…")
        def do():
            import os
            autoload_dir = os.path.expanduser("~/.openvpn3/autoload")
            out, rc = shell_out(
                f"/usr/sbin/openvpn3-autoload --directory {shlex.quote(autoload_dir)}",
                timeout=30,
            )
            if rc == 0:
                self._msg("VPN Connected")
            else:
                self._msg(f"Connect failed: {out[:80]}", "error")
            self._reload()
        run_bg(do)

    def action_vpn_disconnect(self) -> None:
        if not self._sessions:
            self.app.notify("Not connected", severity="information")
            return
        config = self._sessions[0].get("config", "")
        if not config:
            self.app.notify("No VPN config name found", severity="error")
            return
        self.app.notify("Disconnecting VPN…")
        def do():
            out, rc = shell_out(
                f"openvpn3 session-manage --config {shlex.quote(config)} --disconnect",
                timeout=15,
            )
            if rc == 0:
                self._msg("VPN Disconnected")
            else:
                self._msg(f"Disconnect failed: {out[:80]}", "error")
            self._reload()
        run_bg(do)


