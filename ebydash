class InputModal(ModalScreen):
    CSS = """
    InputModal { align: center middle; }
    InputModal > Vertical {
        background: $surface;
        border: thick $accent;
        padding: 1 2;
        width: 60;
        height: auto;
    }
    InputModal Label { margin-bottom: 1; color: $text-muted; }
    """
    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, prompt: str, placeholder: str = ""):
        super().__init__()
        self._prompt      = prompt
        self._placeholder = placeholder

    def compose(self) -> ComposeResult:
        with Vertical():
            yield Label(self._prompt)
            yield Input(placeholder=self._placeholder)

    def on_mount(self) -> None:
        self.query_one(Input).focus()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        val = event.value.strip()
        self.dismiss(val if val else None)

    def action_cancel(self) -> None:
        self.dismiss(None)


class PickerModal(ModalScreen):
    CSS = """
    PickerModal { align: center middle; }
    PickerModal > Vertical {
        background: $surface;
        border: thick $accent;
        padding: 1 2;
        width: 60;
        height: auto;
        max-height: 20;
    }
    PickerModal Label { margin-bottom: 1; color: $text-muted; }
    """
    BINDINGS = [
        Binding("escape", "cancel",      "Cancel"),
        Binding("up",     "cursor_up",   "Up"),
        Binding("down",   "cursor_down", "Down"),
        Binding("enter",  "select",      "Select"),
    ]
    cursor: reactive[int] = reactive(0)

    def __init__(self, prompt: str, items: list[str]):
        super().__init__()
        self._prompt = prompt
        self._items  = items

    def compose(self) -> ComposeResult:
        with Vertical():
            yield Label(self._prompt)
            yield Static("", classes="picker-body")

    def on_mount(self) -> None:
        self._redraw()

    def _redraw(self) -> None:
        try:
            body = self.query_one(".picker-body", Static)
        except Exception:
            return
        body.update("\n".join(
            f"[reverse] {item} [/reverse]" if i == self.cursor else f"  {item}"
            for i, item in enumerate(self._items)
        ))

    def action_cursor_up(self) -> None:
        if self.cursor > 0:
            self.cursor -= 1
            self._redraw()

    def action_cursor_down(self) -> None:
        if self.cursor < len(self._items) - 1:
            self.cursor += 1
            self._redraw()

    def action_select(self) -> None:
        if self._items:
            self.dismiss(self._items[self.cursor])

    def action_cancel(self) -> None:
        self.dismiss(None)


