class SpotifyPane(Pane):
    _title = "[#7aa2f7][6][/#7aa2f7] SPOTIFY"
    can_focus = True

    BINDINGS = [
        Binding("p", "play_pause", "Play/Pause"),
        Binding("n", "next_track", "Next"),
        Binding("b", "prev_track", "Prev"),
    ]

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self._playing = False
        self._frame   = 0

    def compose(self) -> ComposeResult:
        yield self.title_bar()
        yield Static("", id="sp-body")   # no VerticalScroll — fixed height widget

    def on_mount(self) -> None:
        # Animate the dots every 0.4 s (only cosmetic, no I/O)
        self.set_interval(0.8, self._tick)

    def _tick(self) -> None:
        if self._playing:
            self._frame = (self._frame + 1) % 8
            try:
                w = self.query_one("#sp-body", Static)
                # Redraw only the dots line without a full refresh
                self._draw(w, _dots_only=True)
            except Exception:
                pass

    # ── render ─────────────────────────────────────────────────────────────────

    def _progress_bar(self, pos: str, length: str, width: int = 28) -> str:
        """Return a ─────●──── progress bar, or empty string if times unknown."""
        def to_secs(t: str) -> int | None:
            try:
                m, s = t.split(":")
                return int(m) * 60 + int(s)
            except Exception:
                return None
        p, l = to_secs(pos), to_secs(length)
        if p is None or l is None or l == 0:
            return ""
        ratio  = min(p / l, 1.0)
        filled = round(ratio * width)
        bar    = "─" * filled + "●" + "─" * (width - filled)
        return f"[dim]{bar}[/dim]  [dim]{pos}/{length}[/dim]"

    def _dots(self) -> str:
        """Animated 8-dot pulse: ●●●·····  →  ·●●●····  → …"""
        n = 3
        dots = ["·"] * 8
        for i in range(n):
            dots[(self._frame + i) % 8] = "●"
        return "".join(dots)

    def _eq(self) -> str:
        """Tiny animated equalizer used while playing."""
        levels = [1, 3, 2, 4, 2, 3, 1, 4]
        bars: list[str] = []
        for i in range(6):
            h = levels[(self._frame + i) % len(levels)]
            bars.append("▁▂▃▄▅▆▇"[h])
        return "[#7dcfff]" + "".join(bars) + "[/#7dcfff]"

    def _draw(self, w: Static, _dots_only: bool = False) -> None:
        # For dots-only tick we just patch the markup without a full rebuild
        # (cheap — avoids re-reading _data on every frame)
        if _dots_only:
            # Re-render fully anyway — Static.update is cheap
            pass
        data    = getattr(self, "_data", {})
        playing = self._playing
        sc      = "#9ece6a" if playing else "#e0af68"
        si      = "▶" if playing else "⏸"
        status  = data.get("status", "…").capitalize()

        if not data.get("ok"):
            w.update(data.get("msg", ""))
            return

        title   = data.get("title",  "") or "Unknown title"
        artist  = data.get("artist", "") or "Unknown artist"
        album   = data.get("album",  "")
        pos     = data.get("pos",    "")
        length  = data.get("length", "")
        bar     = self._progress_bar(pos, length)

        state_badge = f"[{sc}]●[/{sc}] [bold]{si} {status}[/bold]"
        lines = [
            f" {state_badge}  [bold #c0caf5]{title}[/bold #c0caf5]",
            f"    [#7aa2f7]{artist}[/#7aa2f7]",
        ]
        if album:
            lines.append(f"    [dim]Album: {album}[/dim]")
        lines.append("")
        anim = self._eq() if playing else f"[dim]{self._dots()}[/dim]"
        if bar:
            lines.append(f"  {bar}")
        else:
            lines.append(f"  {anim}")
        lines.append(
            f"  {anim}   [dim]⏮[/dim] [bold]b[/bold]  [dim]⏯[/dim] [bold]p[/bold]  [dim]⏭[/dim] [bold]n[/bold]"
        )
        w.update("\n".join(lines))

    def refresh_content(self, data: dict) -> None:
        self._data    = data
        self._playing = data.get("playing", False)
        if not self._playing:
            self._frame = 0
        try:
            self._draw(self.query_one("#sp-body", Static))
        except Exception as e:
            # Never leave the panel blank if markup/rendering fails.
            try:
                self.query_one("#sp-body", Static).update(f"[red]Spotify render error:[/red] {e}")
            except Exception:
                pass

    # ── controls ───────────────────────────────────────────────────────────────

    def _playerctl(self, cmd: str) -> None:
        def do():
            shell_out(f"playerctl -p spotify {cmd} 2>/dev/null || playerctl {cmd}")
            self.app.call_from_thread(self.app.action_refresh)
        run_bg(do)

    def action_play_pause(self) -> None: self._playerctl("play-pause")
    def action_next_track(self) -> None: self._playerctl("next")
    def action_prev_track(self) -> None: self._playerctl("previous")


