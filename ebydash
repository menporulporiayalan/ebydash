class BranchPane(Pane):
    """Focusable pane — cursor state lives here, display is a plain Static."""

    _title = "[#7aa2f7][3][/#7aa2f7] BRANCHES"
    can_focus = True

    BINDINGS = [
        Binding("up",      "cursor_up",   "Up",       show=False),
        Binding("down",    "cursor_down", "Down",     show=False),
        Binding("enter",   "checkout",    "Checkout"),
        Binding("n",       "new_branch",  "New"),
        Binding("p",       "pull_branch", "Pull"),
        Binding("shift+p", "push_branch", "Push"),
        Binding("m",       "pull_main",   "↓main"),
    ]

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self._items: list[tuple[str, Any]] = []
        self._cursor: int = 0

    def compose(self) -> ComposeResult:
        yield self.title_bar()
        with PaneScroll():
            yield Static("loading…", id="branch-body")

    def _redraw(self) -> None:
        lines = [
            f"[reverse]{d}[/reverse]" if i == self._cursor else d
            for i, (d, _) in enumerate(self._items)
        ]
        self.query_one("#branch-body", Static).update(
            "\n".join(lines) if lines else "[dim]no branches[/dim]"
        )

    def refresh_content(self, branches: list[dict]) -> None:
        items = []
        for b in branches:
            if b["is_current"]:
                disp = f"[bold yellow]  * {b['name']}[/bold yellow]"
            else:
                age  = f"[dim]{b['age']:<4}[/dim]"
                s    = b["sync"]
                sync = (
                    f" [green]{s}[/green]"   if s == "✓"        else
                    f" [red]{s}[/red]"       if s in ("✗","↓")  else
                    f" [yellow]{s}[/yellow]" if s               else ""
                )
                disp = f"{age} {b['name']}{sync}"
            items.append((disp, b))
        self._items = items
        self._cursor = min(self._cursor, max(0, len(items) - 1))
        self._redraw()

    def action_cursor_up(self) -> None:
        if self._cursor > 0:
            self._cursor -= 1
            self._redraw()
            self._scroll_to_cursor()

    def action_cursor_down(self) -> None:
        if self._cursor < len(self._items) - 1:
            self._cursor += 1
            self._redraw()
            self._scroll_to_cursor()

    def _scroll_to_cursor(self) -> None:
        try:
            scroll = self.query_one("PaneScroll", PaneScroll)
            target_y = self._cursor
            scroll.scroll_to(y=target_y, animate=False)
        except Exception:
            pass

    @property
    def _selected(self) -> Any:
        if self._items and 0 <= self._cursor < len(self._items):
            return self._items[self._cursor][1]
        return None

    # ── helpers ───────────────────────────────────────────────────────────────

    def _current_branch(self) -> str:
        out, _ = shell("git branch --show-current 2>/dev/null")
        return out.strip()

    def _upstream_ref(self) -> str:
        out, rc = shell("git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null")
        return out.strip() if rc == 0 else ""

    def _pick_remote(self) -> str:
        # Prefer origin; otherwise first configured remote.
        out, _ = shell("git remote 2>/dev/null")
        remotes = [r.strip() for r in out.splitlines() if r.strip()]
        if "origin" in remotes:
            return "origin"
        return remotes[0] if remotes else ""

    def _msg(self, text: str, severity: str = "information") -> None:
        self.app.call_from_thread(
            lambda t=text, s=severity: self.app.notify(t, severity=s)
        )

    def _reload(self) -> None:
        self.app.call_from_thread(self.app.action_refresh)

    # ── actions ───────────────────────────────────────────────────────────────

    def action_checkout(self) -> None:
        b = self._selected
        if not b:
            return
        if b["is_current"]:
            self.app.notify("Already on this branch", severity="information")
            return
        name = b["name"]

        # Immediate optimistic update — mark target as current right now
        new_items = []
        for disp, data in self._items:
            if data["name"] == name:
                new_items.append((
                    f"[bold yellow]  * {name}[/bold yellow] [dim](switching…)[/dim]",
                    {**data, "is_current": True},
                ))
            elif data.get("is_current"):
                new_items.append((
                    f"[dim]    {data['name']}[/dim]",
                    {**data, "is_current": False},
                ))
            else:
                new_items.append((disp, data))
        self._items = new_items
        self._redraw()

        def do():
            out, rc = shell_out(f"git checkout {shlex.quote(name)}")
            if rc == 0:
                self._msg(f"Switched to {name}")
            else:
                self._msg(f"Checkout failed: {out[:80]}", "error")
            self._reload()   # full refresh regardless (fixes display if it failed)
        run_bg(do)

    def action_new_branch(self) -> None:
        def on_name(name: str | None) -> None:
            if not name:
                return
            def do():
                out, rc = shell_out(f"git checkout -b {shlex.quote(name)}")
                if rc == 0:
                    self._msg(f"Created & switched to {name}")
                    self._reload()
                else:
                    self._msg(f"Error: {out[:80]}", "error")
            run_bg(do)
        self.app.push_screen(InputModal("New branch name:", "feature/my-branch"), on_name)

    def action_pull_branch(self) -> None:
        branch = self._current_branch()
        if not branch:
            self.app.notify("Not on a named branch", severity="warning")
            return
        self.app.notify(f"Pulling {branch}…")
        def do():
            out, rc = shell_out(f"git pull origin {shlex.quote(branch)}")
            if rc == 0:
                self._msg(out.split("\n")[0][:100] or "Up to date")
                self._reload()
            else:
                self._msg(f"Pull failed: {out[:80]}", "error")
        run_bg(do)

    def action_push_branch(self) -> None:
        branch = self._current_branch()
        if not branch:
            self.app.notify("Not on a named branch", severity="warning")
            return
        self.app.notify(f"Pushing {branch}…")
        def do():
            upstream = self._upstream_ref()
            if upstream:
                out, rc = shell_out("git push")
            else:
                remote = self._pick_remote()
                if not remote:
                    self._msg("Push failed: no git remotes configured", "error")
                    return
                out, rc = shell_out(f"git push -u {shlex.quote(remote)} {shlex.quote(branch)}")
            if rc == 0:
                # git push output goes to stderr; grab a meaningful line
                summary = next(
                    (l for l in out.splitlines() if l.strip() and not l.startswith("remote:")),
                    "Pushed",
                )
                self._msg(summary[:100] or "Pushed")
                self._reload()
            else:
                self._msg(f"Push failed: {out[:120]}", "error")
        run_bg(do)

    def action_pull_main(self) -> None:
        self.app.notify("Pulling main…")
        def do():
            out, rc = shell_out("git pull origin main")
            if rc != 0 and "couldn't find remote ref main" in out.lower():
                out, rc = shell_out("git pull origin master")
            if rc == 0:
                self._msg(out.split("\n")[0][:100] or "Up to date")
                self._reload()
            else:
                self._msg(f"Pull failed: {out[:80]}", "error")
        run_bg(do)


